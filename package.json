{
  "name": "shardy",
  "version": "1.4.1",
  "description": "Framework for online games and applications on Node.js",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.12.1",
  "author": "Mopsicus <mail@mopsicus.ru>",
  "homepage": "https://github.com/mopsicus/shardy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mopsicus/shardy.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepublishOnly": "npm run check",
    "bench:connection": "npm run build && node benchmark/connection.mjs",
    "bench:timers": "npm run build && node benchmark/timers.mjs",
    "format": "prettier --config .prettierrc --write \"src/**/*.ts\"",
    "format:check": "prettier --config .prettierrc --check \"src/**/*.ts\"",
    "lint": "eslint src"
  },
  "keywords": [
    "shardy",
    "microservice",
    "framework",
    "rpc",
    "web",
    "netcode",
    "games",
    "engine",
    "networking",
    "multiplayer",
    "websocket",
    "realtime",
    "server",
    "socket",
    "typescript",
    "nodejs"
  ],
  "bugs": {
    "url": "https://github.com/mopsicus/shardy/issues"
  },
  "dependencies": {
    "winston": "^3.19.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
